<!--
Description:
  Automix rows under the channel strips (Etapa 0, docs/decisions/0017):
  recipe selector, countdown, and the manual/resume button; below them the
  vocal guard switch (GARDA VOCE / VOCE LIBERA, stem tracks only).
  The selector states must stay in the order of
  AutomixRecipeBook::selectorIds() in src/mixer/automixrecipe.cpp.
-->
<Template>
  <WidgetGroup>
    <ObjectName>AutomixRow</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>

          <PushButton>
            <TooltipId>automix_recipe</TooltipId>
            <ObjectName>AutomixRecipeButton</ObjectName>
            <Size>78f,20f</Size>
            <NumberStates>5</NumberStates>
            <State>
              <Number>0</Number>
              <Text>URGENTA 2</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>SCURT 4</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>2</Number>
              <Text>STANDARD 8</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>3</Number>
              <Text>LUNG 16</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>4</Number>
              <Text>FADE CURAT</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[AutomixTransition],recipe</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>4f,0min</Size></WidgetGroup>

          <!-- Fixed-size slot so hiding the number does not shift the row. -->
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>26f,20f</Size>
            <Children>
              <Number>
                <TooltipId>automix_countdown</TooltipId>
                <ObjectName>AutomixCountdown</ObjectName>
                <Size>26f,20f</Size>
                <NumberOfDigits>0</NumberOfDigits>
                <Alignment>center</Alignment>
                <Connection>
                  <ConfigKey>[AutomixTransition],countdown</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey>[AutomixTransition],state</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Number>
            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>4f,0min</Size></WidgetGroup>

          <PushButton>
            <TooltipId>automix_resume</TooltipId>
            <ObjectName>AutomixResumeButton</ObjectName>
            <Size>78f,20f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>AUTO</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>REIA AUTO</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[AutomixTransition],resume</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
              <ConnectValueToWidget>false</ConnectValueToWidget>
            </Connection>
            <Connection>
              <ConfigKey>[AutomixTransition],manual</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,3f</Size></WidgetGroup>

      <!-- Vocal guard (src/mixer/automixvocalguard.h): 1 = the old voice
           finishes its phrase before the new one comes in, 0 = voices may
           overlap. Persisted; read when a transition starts. -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>

          <PushButton>
            <TooltipId>automix_vocal_guard</TooltipId>
            <ObjectName>AutomixVocalGuardButton</ObjectName>
            <Size>84f,20f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>VOCE LIBERA</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>GARDA VOCE</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[AutomixTransition],vocal_guard</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>1min,3f</Size></WidgetGroup>

      <!-- Key guard (src/mixer/automixkeyguard.h): 1 = with clashing keys
           only the new drums come in until half the transition, then the
           bass, instruments and voice swap; 0 = plain EQ blend. Persisted;
           read when a transition starts. -->
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>

          <PushButton>
            <TooltipId>automix_key_guard</TooltipId>
            <ObjectName>AutomixKeyGuardButton</ObjectName>
            <Size>84f,20f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>TON LIBER</Text>
              <Alignment>center</Alignment>
            </State>
            <State>
              <Number>1</Number>
              <Text>GARDA TON</Text>
              <Alignment>center</Alignment>
            </State>
            <Connection>
              <ConfigKey>[AutomixTransition],key_guard</ConfigKey>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>

          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
