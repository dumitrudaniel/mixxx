<Template>

  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>WaveformsContainer</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <!-- SeratoLike only ever shows 2 decks (see skin.xml manifest:
          [App],num_decks=2, [Skin],show_4decks forced 0), so deck 3/4
          waveform rows from LateNight were dropped entirely here instead
          of being kept as dead, always-hidden branches. Deck 1's strip sits
          directly above deck 2's strip, full width each — this is the
          "parallel horizontal waveforms up top" layout from PLAN.md. -->
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Size>100me,68me</Size>
            <Children>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <Template src="skins:SeratoLike/waveform.xml">
                    <SetVariable name="ChanNum">1</SetVariable>
                    <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
                    <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_12"/></SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <!-- Phase guide: thin mark-free strips, one per deck, sandwiched
              between the two main waveforms so their beat ticks (and
              playhead lines) can be compared at a glance, independent of
              Sync. See phase_strip.xml and docs/decisions/0006. -->
              <Template src="skins:SeratoLike/phase_strip.xml">
                <SetVariable name="ChanNum">1</SetVariable>
                <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_12"/></SetVariable>
              </Template>
              <Template src="skins:SeratoLike/phase_strip.xml">
                <SetVariable name="ChanNum">2</SetVariable>
                <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_12"/></SetVariable>
              </Template>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>
                  <Template src="skins:SeratoLike/waveform.xml">
                    <SetVariable name="ChanNum">2</SetVariable>
                    <SetVariable name="SignalColor"><Variable name="SignalColor_12"/></SetVariable>
                    <SetVariable name="BgColorWaveform"><Variable name="BgColorWaveform_12"/></SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          <WidgetGroup><Size>1f,1min</Size></WidgetGroup>

          <Template src="skins:SeratoLike/controls/button_2state_persist.xml">
            <SetVariable name="TooltipId">show_beatgrid_controls</SetVariable>
            <SetVariable name="ObjectName">BeatgridControlsToggle</SetVariable>
            <SetVariable name="Size">26f,52f</SetVariable>
            <SetVariable name="BtnSize"></SetVariable>
            <SetVariable name="ConfigKey">[Skin],show_beatgrid_controls</SetVariable>
          </Template>

          <WidgetGroup>
            <Size>2f,1min</Size>
            <Connection>
              <ConfigKey>[Master],skin_settings</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
        <Connection>
          <ConfigKey>[Master],skin_settings</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </WidgetGroup><!-- WaveformsContainer -->

    </Children>
  </WidgetGroup>
</Template>
